# Salin ke .env (di-gitignore). Konfigurasi service hanya dari environment.
# Wajib: database PostgreSQL bersama (skema dimiliki eabsensi-v2, dipin lewat SCHEMA_VERSION).
DATABASE_URL=postgres://pengguna:kata_sandi@127.0.0.1:5432/eabsensi_v2

# Opsional (nilai di bawah adalah bawaan).
# Port sendiri, terpisah dari web dan API mobile.
ADMS_BIND_ADDR=0.0.0.0:8090
# Batas ukuran body request (byte). Batch ATTLOG besar masih jauh di bawah ini.
ADMS_MAX_BODY_BYTES=8388608
ADMS_REQUEST_TIMEOUT_SECS=30
ADMS_DB_MAX_CONNECTIONS=10
ADMS_DB_ACQUIRE_TIMEOUT_SECS=5
# Perintah ke mesin yang tidak dijawab dikirim ulang setelah sekian detik, maksimal sekian kali.
ADMS_COMMAND_ACK_TIMEOUT_SECS=120
ADMS_COMMAND_MAX_ATTEMPTS=3
# Penerimaan log absensi: zona bisnis penentu bulan punch (harus sama dengan ATTENDANCE_TIMEZONE di v2),
# batas bawah waktu log mesin, dan ambang log "di masa depan" (detik) yang ditandai suspect.
ADMS_ATTENDANCE_TIMEZONE=Asia/Jakarta
ADMS_MIN_LOG_TIME=2020-01-01 00:00:00
ADMS_SUSPECT_FUTURE_SECS=500

# Biometrik terenkripsi (AES-256-GCM, keputusan D1). Tanpa BIOMETRIC_KEY template TIDAK diterima dan
# tidak bisa dikirim ke mesin (tidak pernah disimpan tanpa enkripsi).
# Buat kunci 32 byte base64:  openssl rand -base64 32
#   atau PowerShell:  [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }) -as [byte[]])
# BIOMETRIC_KEY=
# BIOMETRIC_KEY_ID=k1
# Rotasi: kunci terkini di atas (id baru), kunci lama hanya untuk membaca, format id=base64,id=base64
# BIOMETRIC_OLD_KEYS=k1=...
# Simpan juga foto wajah (BIOPHOTO), bukan hanya template. Bawaan false.
# BIOMETRIC_STORE_FACE_PHOTO=false
# Level log JSON (tracing EnvFilter), mis. info atau eabsensi_adms=debug,info.
RUST_LOG=info
