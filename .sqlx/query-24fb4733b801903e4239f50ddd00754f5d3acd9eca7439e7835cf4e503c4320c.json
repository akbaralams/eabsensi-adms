  "query": "SELECT id, employee_id, kind, finger_index, algorithm_version, is_valid,\n                  original_size, ciphertext, nonce, key_id\n             FROM biometric_templates\n            WHERE key_id <> $1\n              AND ($2::text IS NULL OR key_id = $2)\n              AND id > $3\n            ORDER BY id\n            LIMIT $4",
