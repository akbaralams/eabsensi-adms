  "query": "SELECT l.pin AS \"pin!\", l.device_time AS \"device_time!\"\n             FROM device_logs l\n             JOIN UNNEST($2::text[], $3::timestamp[]) AS t(pin, device_time)\n               ON l.pin = t.pin AND l.device_time = t.device_time\n            WHERE l.device_id = $1",
