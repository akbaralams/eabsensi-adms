  "query": "SELECT id,\n                  serial_number,\n                  device_type,\n                  push_version,\n                  initialized_at IS NOT NULL AS \"initialized!\",\n                  timezone,\n                  poll_delay_seconds,\n                  error_delay_seconds,\n                  attlog_stamp,\n                  operlog_stamp,\n                  photo_stamp,\n                  biodata_stamp,\n                  NULLIF(left(reported_options ->> '~ZKFPVersion', 16), '') AS fp_version,\n                  NULLIF(left(reported_options ->> 'FaceVersion', 16), '') AS face_version\n             FROM devices\n            WHERE serial_number = $1 AND is_active",
